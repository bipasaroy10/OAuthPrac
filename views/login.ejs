<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Practice Web App</title>
  <!-- Font Awesome CDN for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="dark-theme">
  <div class="auth-card">
    <div class="header">
      <!-- Default Profile Avatar Placeholder -->
      <div class="avatar-placeholder">
        <i class="fa-solid fa-user"></i>
      </div>
      <h1>Practice Web App</h1>
      <p class="subtitle">Sign in to continue</p>
    </div>

    <div class="auth-buttons">
      <!-- Original Providers -->
      <a href="/auth/google" class="btn btn-google">
        <i class="fa-brands fa-google"></i> Sign in with Google
      </a>
      <a href="/auth/facebook" class="btn btn-facebook">
        <i class="fa-brands fa-facebook"></i> Sign in with Facebook
      </a>

      <!-- Additional Requested Providers -->
      <a href="/auth/twitter" class="btn btn-x">
        <i class="fa-brands fa-x-twitter"></i> Sign in with X
      </a>
      <a href="/auth/spotify" class="btn btn-spotify">
        <i class="fa-brands fa-spotify"></i> Sign in with Spotify
      </a>
      <a href="/auth/discord" class="btn btn-discord">
        <i class="fa-brands fa-discord"></i> Sign in with Discord
      </a>
      <a href="/auth/linkedin" class="btn btn-linkedin">
        <i class="fa-brands fa-linkedin-in"></i> Sign in with LinkedIn
      </a>
      <a href="/auth/slack" class="btn btn-slack">
        <i class="fa-brands fa-slack"></i> Sign in with Slack
      </a>
      <a href="/auth/twitch" class="btn btn-twitch">
        <i class="fa-brands fa-twitch"></i> Sign in with Twitch
      </a>
      <a href="/auth/github" class="btn btn-github">
        <i class="fa-brands fa-github"></i> Sign in with GitHub
      </a>
      <a href="/auth/gitlab" class="btn btn-gitlab">
        <i class="fa-brands fa-gitlab"></i> Sign in with GitLab
      </a>
    </div>
  </div>
</body>
</html>